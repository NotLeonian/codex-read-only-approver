* text=auto eol=lf

# Common binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.7z    binary
*.jar   binary
*.war   binary
*.class binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

# Markdown
*.md         text diff=markdown whitespace=-blank-at-eol linguist-language=Markdown
*.mdx        text diff=markdown whitespace=-blank-at-eol linguist-language=Markdown
*.md.example text diff=markdown whitespace=-blank-at-eol linguist-language=Markdown
*.md.snippet text diff=markdown whitespace=-blank-at-eol linguist-language=Markdown

# License
LICENSE text

# Python
*.py    text diff=python
*.pyi   text diff=python
*.pyw   text diff=python

# Generated Python binary files
*.pyc   binary
*.pyo   binary
*.pyd   binary

# JSON
*.json         text
*.json.example text

# YAML
*.yml          text linguist-language=YAML
*.yaml         text linguist-language=YAML
*.yaml.example text linguist-language=YAML

# Configuration and lock files
*.in            text
*.toml          text
*.lock          text
*.rules.example text
