{
	"description": "Auto-approve statically read-only Bash approval requests; defer everything else to the human reviewer.",
	"hooks": {
		"PermissionRequest": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$HOME/.codex/hooks/codex_read_only_approver.py\"",
						"timeout": 3,
						"statusMessage": "Checking whether the Bash command is statically read-only"
					}
				]
			}
		]
	}
}
